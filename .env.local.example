# JK Toolkit Studio — Environment Variables
# Copy to .env.local and fill in your values

# Optional: remove.bg API key for server-side background removal
REMOVE_BG_API_KEY=your_key_here

# Optional: PostgreSQL for SaaS mode
DATABASE_URL=postgresql://user:password@localhost:5432/jk_studio

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
